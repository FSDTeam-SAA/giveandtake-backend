PORT=5000
MONGO_URI=mongodb://localhost:27017/myapp
JOB_POST_PAYWALL_ENABLED=true

# Cloudflare R2 — object storage for uploads.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# PRIVATE bucket for access-controlled videos (elevator-pitch HLS). Keep private.
R2_BUCKET_NAME=
# PUBLIC bucket for images + public recruiter intro video (separate bucket with
# public access enabled). Per-bucket public access — do NOT reuse the video bucket.
R2_PUBLIC_BUCKET_NAME=
# Public origin for the public bucket: its Development URL (https://pub-<hash>.r2.dev)
# or a mapped custom domain (https://cdn.example.com). No trailing slash.
R2_PUBLIC_BASE=
# Optional dedicated token (Object Read & Write) scoped to the public bucket.
# Leave empty to reuse R2_ACCESS_KEY_ID/SECRET (one all-buckets token).
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
