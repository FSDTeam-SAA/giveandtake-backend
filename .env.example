PORT=5000
MONGO_URI=mongodb://localhost:27017/myapp
JOB_POST_PAYWALL_ENABLED=true

# ===================== PAYMENTS =====================
# PayPal — the client id is also exposed to the frontend as
# NEXT_PUBLIC_PAYPAL_CLIENT_ID and the two must match.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Stripe — the publishable key is also exposed to the frontend as
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY and the two must match.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional. Set after registering the endpoint in the Stripe dashboard
# (Developers > Webhooks > POST /api/v1/payments/stripe/webhook) to enable the
# server-side safety net for payments whose browser confirm call never lands.
STRIPE_WEBHOOK_SECRET=

# ============ IN-APP PURCHASES (mobile candidate subscription) ============
# Apple: App Store Connect > Users and Access > Integrations > In-App Purchase.
# Use the In-App Purchase key (SubscriptionKey_XXXX.p8), not an App Store
# Connect API key. Give the key as a file path on the server, or inline with
# \n for line breaks. Never commit the key.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_IAP_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.pooelcentral.giveandtake
# auto = production first, then sandbox (TestFlight / App Review purchases).
APPLE_IAP_ENVIRONMENT=auto
APPLE_IAP_CANDIDATE_PRODUCT_IDS=com.pooelcentral.giveandtake.candidate.premium
# App Store Server Notifications V2 URL (Production and Sandbox):
#   https://<api-host>/api/v1/payments/iap/apple/notifications

# Google: a service account invited in Play Console with "View financial data"
# and "Manage orders and subscriptions". JSON as a file path, or inline.
GOOGLE_PLAY_PACKAGE_NAME=com.evpitchrecruitment.careers
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_CANDIDATE_PRODUCT_IDS=candidate_monthly
# Real-time developer notifications: Pub/Sub push subscription to
#   https://<api-host>/api/v1/payments/iap/google/notifications?token=<GOOGLE_PLAY_RTDN_TOKEN>
GOOGLE_PLAY_RTDN_TOKEN=

# Optional. Plan that store purchases are recorded against. Defaults to the
# cheapest active candidate monthly plan.
IAP_CANDIDATE_PLAN_ID=
